{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SVG Viewer",
  "version": "0.1.0",
  "identifier": "com.svgviewer.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SVG Viewer",
        "width": 240,
        "height": 120,
        "minWidth": 200,
        "minHeight": 100
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["svg"],
        "name": "SVG Image",
        "description": "Scalable Vector Graphics image",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
